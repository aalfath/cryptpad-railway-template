{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10
	}
}

:{$PORT} {
	# Health of this proxy itself, so it can come up before CryptPad has finished its first boot.
	handle /healthz {
		respond "ok" 200
	}
	handle {
		reverse_proxy {$CRYPTPAD_UPSTREAM} {
			# CryptPad checks nothing on Host, but keep the public one for its logs.
			header_up Host {host}
		}
	}
}
